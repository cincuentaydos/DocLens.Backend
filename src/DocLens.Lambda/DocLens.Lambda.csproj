<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AWSProjectType>Lambda</AWSProjectType>
    <RootNamespace>DocLens.Lambda</RootNamespace>
    <!-- provided.al2023 has no libicu — self-contained .NET's globalization
         init crashes on startup without this (see Runtime.ExitError /
         "Couldn't find a valid ICU package" in CloudWatch). No feature
         here needs culture-specific formatting, so invariant is fine. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.1.0" />
    <PackageReference Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageReference Include="Amazon.Lambda.RuntimeSupport" Version="2.2.3" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageReference Include="AWS.Lambda.Powertools.Logging" Version="3.2.2" />
    <PackageReference Include="AWS.Lambda.Powertools.Metrics" Version="3.2.2" />
    <PackageReference Include="AWS.Lambda.Powertools.Tracing" Version="3.2.2" />
    <PackageReference Include="AWSSDK.BedrockAgent" Version="4.0.103" />
    <PackageReference Include="AWSSDK.BedrockAgentRuntime" Version="4.0.102.6" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.20.4" />
    <PackageReference Include="AWSSDK.Comprehend" Version="4.0.100.14" />
    <PackageReference Include="AWSSDK.EventBridge" Version="4.0.101" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.4.5" />
    <PackageReference Include="AWSSDK.RDSDataService" Version="4.0.100" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.6" />
    <PackageReference Include="AWSSDK.StepFunctions" Version="4.0.100.15" />
    <PackageReference Include="AWSSDK.Textract" Version="4.0.4.5" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
