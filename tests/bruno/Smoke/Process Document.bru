meta {
  name: Process Document
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/documents/process
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{idToken}}
}

body:json {
  {
    "documentId": "00000000-0000-4000-8000-000000000001",
    "s3Key": "test-tenant/documents/00000000-0000-4000-8000-000000000001/v1.pdf",
    "documentType": 0
  }
}

tests {
  // The documentId/s3Key above don't match a prepared version, so the
  // endpoint answers 404 (or 409 for a version still pending malware scan).
  // What this DOES prove: the JWT authorizer accepted the token,
  // TenantMiddleware resolved custom:tenantId, and the Lambda ran the
  // handler under /api — i.e. not an auth/routing failure.
  test("request is authenticated and reaches the handler", function () {
    expect(res.getStatus()).to.not.equal(401);
    expect(res.getStatus()).to.not.equal(403);
  });
}
