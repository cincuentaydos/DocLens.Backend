meta {
  name: Upload File to S3
  type: http
  seq: 3
}

put {
  url: {{uploadUrl}}
  body: text
  auth: none
}

headers {
  Content-Type: text/plain
}

body:text {
  Este es un documento demo de DocLens.
  
  Doclens es el sistema de inteligencia para abogados integrados con IA y RAG.
  Doclens hace la extracción de las informaciones de documentos de forma segura y cumpliendo con las normativs RGPD en Europa.
  
  Doclens funciona como un middleware de seguridad entre los documentos originales y los documentos que se envian a los modelos LLMs para generación de chunks y embeddings, garantizando la limpieza de los datos personales.
}

tests {
  test("S3 accepted the upload", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
